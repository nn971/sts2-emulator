<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the *same source files* as the actual bridge against tiny
         compile-only API stubs. No game binary is distributed or required. -->
    <Compile Include="../../tools/reference_bridge/BridgeWorkspace.cs" Link="BridgeWorkspace.cs" />
    <Compile Include="../../tools/reference_bridge/PassiveReferenceRecorder.cs" Link="PassiveReferenceRecorder.cs" />
    <Compile Include="../../tools/reference_bridge/PassiveReferenceRecorder.RunCapture.cs" Link="PassiveReferenceRecorder.RunCapture.cs" />
    <Compile Include="../../tools/reference_bridge/ReferenceBridgeMod.cs" Link="ReferenceBridgeMod.cs" />
  </ItemGroup>
</Project>
